<section class="auth-container">
  <div class="auth-card">
    <h1>Регистрация</h1>

    <% if @user.errors.any? %>
      <div class="form-errors">
        <p>Пожалуйста, исправьте ошибки:</p>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, class: "auth-form" do |form| %>
      <div class="form-group">
        <%= form.label :username, "Имя пользователя" %>
        <%= form.text_field :username, required: true %>
      </div>

      <div class="form-group">
        <%= form.label :email, "Электронная почта" %>
        <%= form.email_field :email, required: true %>
      </div>

      <div class="form-group">
        <%= form.label :password, "Пароль" %>
        <%= form.password_field :password, required: true %>
      </div>

      <div class="form-group">
        <%= form.label :password_confirmation, "Повторите пароль" %>
        <%= form.password_field :password_confirmation, required: true %>
      </div>

      <%= form.submit "Зарегистрироваться", class: "button" %>
    <% end %>
  </div>
</section>