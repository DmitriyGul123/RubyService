<section class="auth-container">
  <div class="auth-card">
    <h1>Войти</h1>

    <%= form_with url: login_path, class: "auth-form" do |form| %>
      <div class="form-group">
        <%= form.label :email, "Электронная почта" %>
        <%= form.email_field :email, required: true %>
      </div>

      <div class="form-group">
        <%= form.label :password, "Пароль" %>
        <%= form.password_field :password, required: true %>
      </div>

      <%= form.submit "Войти", class: "button" %>
    <% end %>
    <p class="auth-switch">Ещё нет аккаунта? <%= link_to "Зарегистрироваться", new_user_path %></p>
  </div>
</section>