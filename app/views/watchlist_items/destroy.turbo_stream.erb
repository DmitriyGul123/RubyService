<%= turbo_stream.replace "watchlist-count", partial: "shared/watchlist_count", locals: { user: current_user, count: @watchlist_count } %>
<% if @remove_from_watchlist %>
  <%= turbo_stream.remove dom_id(@title, :watchlist) %>
<% else %>
  <%= turbo_stream.replace dom_id(@title, :watchlist_button), partial: "shared/watchlist_button", locals: { title: @title, saved: false, from_watchlist: false } %>
<% end %>